{
    "version": "2.0.0",
    "tasks": [
        {
            "type": "cppbuild",
            "label": "C/C++: g++.exe build project",
            "command": "C:\\msys64\\ucrt64\\bin\\g++.exe",
            "args": [
                "-std=c++11",
                "-Wall",
                "-Wextra",
                "-fdiagnostics-color=always",
                "-g",
                "-I${workspaceFolder}/CauTrucDuLieu",
                "-I${workspaceFolder}/DoiTuong",
                "-I${workspaceFolder}/TienIch",
                "-I${workspaceFolder}/GiaoDien",
                "-I${workspaceFolder}/NghiepVu",
                "${workspaceFolder}/main.cpp",
                "${workspaceFolder}/DoiTuong/*.cpp",
                "${workspaceFolder}/TienIch/*.cpp",
                "${workspaceFolder}/GiaoDien/*.cpp",
                "${workspaceFolder}/NghiepVu/*.cpp",
                "-o",
                "${workspaceFolder}/main.exe"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        }
    ]
}
